{
  "name": "@scoutly/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "check:links": "tsx scripts/check-links.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "check:claims": "tsx scripts/check-claims.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:hex": "tsx scripts/check-hex.ts",
    "check:launch": "tsx scripts/check-launch.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:hex && pnpm check:placeholders && pnpm check:claims && pnpm check:content && pnpm build && pnpm test:a11y && pnpm check:links && pnpm lighthouse",
    "measure:js": "tsx scripts/measure-js.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
