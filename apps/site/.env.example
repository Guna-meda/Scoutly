# Copy to .env.local. Never commit real values. See docs/site/PAGES.md section 3.

# "production" enables indexing. Anything else (or unset) renders noindex and robots disallow.
NEXT_PUBLIC_ENV=

# WhatsApp number, digits only, international format. Placeholder until the owner supplies it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canonical site URL, e.g. https://example.com (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# How waitlist submissions are stored. Decided in W05.
WAITLIST_STORE=

# Salt for hashing IPs in the rate limiter. Use a long random string.
RATE_LIMIT_SALT=

# Analytics provider settings. Loaded only after consent. Provider chosen later.
ANALYTICS_PROVIDER=
ANALYTICS_KEY=
